      "description": "Filter chips; selected state shown.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Todas</button><button class=\"ds-chip\" aria-pressed=\"false\">3ra</button><button class=\"ds-chip\" aria-pressed=\"false\">4ta</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;height:36px;padding:0 14px;border-radius:6px;border:1px solid rgba(255,255,255,.14);background:transparent;color:#BAC1CF;font-size:13px;font-weight:500;cursor:pointer;transition:color 180ms ease,border-color 180ms ease,background-color 180ms ease,transform 140ms cubic-bezier(.23,1,.32,1)}.ds-chip:hover{color:#F6F4EF}.ds-chip:active{transform:scale(.96)}.ds-chip:focus-visible{outline:2px solid #F3DC9A;outline-offset:2px}.ds-chip[aria-pressed=true]{color:#0A0D14;background:#D4AF5A;border-color:#D4AF5A;font-weight:700}"
    },
    {
      "name": "State Tags",
      "kind": "chip",
      "refersTo": "tag-live",
      "description": "Live, paid, pending, gold and mute status tags.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-live\">En vivo</span><span class=\"ds-tag ds-ok\">Pagado</span><span class=\"ds-tag ds-pend\">Pendiente</span><span class=\"ds-tag ds-gold\">4ta · Cuartos</span><span class=\"ds-tag ds-mute\">Finalizado</span></div>",
      "css": ".ds-tags{display:flex;gap:8px;flex-wrap:wrap}.ds-tag{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-radius:4px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}.ds-live{background:rgba(240,72,79,.14);color:#FF8A8F}.ds-live::before{content:'';width:6px;height:6px;border-radius:50%;background:#F0484F;animation:ds-pulse 1.6s ease-in-out infinite}@keyframes ds-pulse{50%{opacity:.25}}.ds-ok{background:rgba(67,192,143,.13);color:#7BDDB5}.ds-pend{background:rgba(240,154,74,.13);color:#FFB877}.ds-gold{background:rgba(212,175,90,.08);color:#F3DC9A;border:1px solid rgba(212,175,90,.28)}.ds-mute{background:rgba(255,255,255,.06);color:#BAC1CF}@media (prefers-reduced-motion:reduce){.ds-live::before{animation:none}}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "seg-control",
      "description": "Two-option switch with a sliding gold indicator.",
      "html": "<div class=\"ds-seg\"><span class=\"ds-seg-ind\"></span><button aria-pressed=\"true\">Puntos</button><button aria-pressed=\"false\">Final</button></div>",
      "css": ".ds-seg{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;position:relative;display:grid;grid-template-columns:1fr 1fr;width:300px;padding:4px;border-radius:6px;background:#0E1626;border:1px solid rgba(255,255,255,.08)}.ds-seg button{position:relative;z-index:1;height:40px;border:0;background:none;font:inherit;font-size:13px;font-weight:600;color:#97A0B2;cursor:pointer;transition:color 180ms ease}.ds-seg button[aria-pressed=true]{color:#0A0D14}.ds-seg button:focus-visible{outline:2px solid #F3DC9A;outline-offset:2px}.ds-seg-ind{position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);border-radius:4px;background:linear-gradient(100deg,#8C6A2E 0%,#B88F42 22%,#D4AF5A 40%,#F3DC9A 52%,#D4AF5A 64%,#A07B36 84%,#8C6A2E 100%);transition:transform 220ms cubic-bezier(.77,0,.175,1)}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Text field; border turns gold on focus.",
      "html": "<label class=\"ds-field\"><input placeholder=\"Busca por nombre o @usuario\"></label>",
      "css": ".ds-field{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;display:flex;align-items:center;width:320px;height:52px;padding:0 14px;border-radius:6px;background:#0E1626;border:1px solid rgba(255,255,255,.14);transition:border-color 180ms ease}.ds-field:focus-within{border-color:#D4AF5A}.ds-field input{flex:1;background:none;border:0;outline:0;font:inherit;font-size:16px;color:#F6F4EF;caret-color:#D4AF5A}.ds-field input::placeholder{color:#97A0B2}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Floating four-tab bar with skewed gold indicator.",
      "html": "<nav class=\"ds-tabbar\"><a class=\"ds-tab\" aria-selected=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z\"/></svg>Inicio</a><a class=\"ds-tab\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 5h5v4H4zM4 15h5v4H4zM15 10h5v4h-5zM9 7h3v10H9M12 12h3\"/></svg>Cuadro</a><a class=\"ds-tab\"><svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M4 10h16M9 3v4M15 3v4\"/></svg>Horarios</a><a class=\"ds-tab\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/></svg>Perfil</a><span class=\"ds-tab-ind\"><i></i></span></nav>",
      "css": ".ds-tabbar{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;position:relative;display:grid;grid-template-columns:repeat(4,1fr);width:366px;height:56px;border-radius:16px;background:rgba(19,32,55,.92);border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(12px)}.ds-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#97A0B2;cursor:pointer;transition:color 180ms ease}.ds-tab:hover{color:#BAC1CF}.ds-tab[aria-selected=true]{color:#F3DC9A}.ds-tab svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-tab-ind{position:absolute;bottom:6px;left:0;width:25%;display:flex;justify-content:center;pointer-events:none}.ds-tab-ind i{display:block;width:22px;height:3px;background:linear-gradient(100deg,#8C6A2E 0%,#B88F42 22%,#D4AF5A 40%,#F3DC9A 52%,#D4AF5A 64%,#A07B36 84%,#8C6A2E 100%);transform:skewX(-30deg)}"
    },
    {
      "name": "Gold Slash Duel",
      "kind": "custom",
      "refersTo": "gold-slash",
      "description": "Signature: next-match poster duel with meta row.",
      "html": "<div class=\"ds-next\"><div class=\"ds-duel\"><div class=\"ds-pair\">Gasparini<br>De Anda<small>Tú y Chispita</small></div><div class=\"ds-slash\"></div><div class=\"ds-pair ds-r\">Lozano<br>Treviño<small>Sembrados #5</small></div></div><div class=\"ds-meta\"><div><span class=\"ds-s\">Cancha</span><span class=\"ds-d ds-gold\">3</span></div><div><span class=\"ds-s\">Hora</span><span class=\"ds-d\">17:30</span></div><div><span class=\"ds-s\">Faltan</span><span class=\"ds-d\">42 min</span></div></div></div>",
      "css": ".ds-next{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;width:350px;padding:20px 20px 16px;border-radius:10px;background:linear-gradient(160deg,#1B2A4A 0%,#0E1626 70%);border:1px solid rgba(212,175,90,.28);box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 22px 48px -20px rgba(0,0,0,.85);color:#F6F4EF}.ds-duel{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px}.ds-pair{font-stretch:62%;font-weight:900;font-style:italic;text-transform:uppercase;line-height:.9;font-size:30px}.ds-pair small{display:block;font-size:12px;font-stretch:100%;font-weight:500;font-style:normal;text-transform:none;color:#97A0B2;margin-top:6px}.ds-r{text-align:right}.ds-slash{width:22px;height:64px;background:linear-gradient(180deg,#F3DC9A 0%,#D4AF5A 45%,#8C6A2E 100%);transform:skewX(-18deg);border-radius:1px;box-shadow:6px 10px 18px -8px rgba(0,0,0,.7)}.ds-meta{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.08)}.ds-meta div{display:grid;gap:4px}.ds-s{font-stretch:125%;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#BAC1CF}.ds-d{font-stretch:62%;font-weight:900;font-style:italic;text-transform:uppercase;font-size:30px;line-height:.88;font-variant-numeric:tabular-nums}.ds-gold{background:linear-gradient(100deg,#8C6A2E 0%,#B88F42 22%,#D4AF5A 40%,#F3DC9A 52%,#D4AF5A 64%,#A07B36 84%,#8C6A2E 100%);background-size:200% 100%;background-position:50% 0;-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.12em}"
    },
    {
      "name": "Scoreboard Row + Point Box",
      "kind": "custom",
      "refersTo": "point-box",
      "description": "Live score rows: serve dot, set scores, point well.",
      "html": "<div class=\"ds-board\"><div class=\"ds-row ds-serving\"><div class=\"ds-nm\"><i></i>Romo / Alcalá</div><div class=\"ds-st ds-won\">6</div><div class=\"ds-st ds-cur\">3</div><div class=\"ds-st\">-</div><div class=\"ds-pt\"><span>40</span></div></div><div class=\"ds-row\"><div class=\"ds-nm\"><i></i>Ibarra / Villaseñor</div><div class=\"ds-st\">4</div><div class=\"ds-st ds-cur\">2</div><div class=\"ds-st\">-</div><div class=\"ds-pt\"><span>15</span></div></div></div>",
      "css": ".ds-board{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;width:350px;padding:8px 16px;border-radius:10px;background:linear-gradient(180deg,#132037,#0E1626);border:1px solid rgba(255,255,255,.08);color:#F6F4EF}.ds-row{display:grid;grid-template-columns:1fr repeat(3,34px) 64px;align-items:center;gap:6px;padding:12px 0}.ds-row+.ds-row{border-top:1px solid rgba(255,255,255,.08)}.ds-nm{font-stretch:62%;font-weight:900;font-style:italic;text-transform:uppercase;font-size:21px;line-height:.95;display:flex;align-items:center;gap:8px}.ds-nm i{width:8px;height:8px;border-radius:50%;background:#D4AF5A;opacity:0;flex:none}.ds-serving .ds-nm i{opacity:1}.ds-st{text-align:center;font-size:20px;font-weight:700;color:#97A0B2;font-variant-numeric:tabular-nums}.ds-cur{color:#F6F4EF}.ds-won{color:#F3DC9A}.ds-pt{height:56px;border-radius:6px;background:#0A0D14;border:1px solid rgba(255,255,255,.08);display:grid;place-items:center}.ds-pt span{font-stretch:62%;font-weight:900;font-style:italic;font-size:36px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Bracket Match",
      "kind": "card",
      "refersTo": "bracket-match",
      "description": "Draw box: caption strip, winner in champagne, loser slate; live border.",
      "html": "<div class=\"ds-bm\"><div class=\"ds-cap\"><span>Cancha 2</span><span class=\"ds-lv\">En vivo</span></div><div class=\"ds-bmr ds-w\"><span class=\"ds-n\">Marvin / Becker</span><span class=\"ds-sc\">6 4</span></div><div class=\"ds-bmr ds-l\"><span class=\"ds-n\">Navarro / Quiñones</span><span class=\"ds-sc\">3 2</span></div></div>",
      "css": ".ds-bm{font-family:'Archivo','Arial Narrow',system-ui,sans-serif;width:200px;background:#0E1626;border:1px solid rgba(240,72,79,.5);border-radius:6px;overflow:hidden;color:#F6F4EF}.ds-cap{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#97A0B2;padding:5px 10px;background:rgba(0,0,0,.18)}.ds-lv{color:#FF8A8F}.ds-bmr{display:flex;align-items:center;height:36px;padding:0 10px;gap:8px;font-size:13px}.ds-bmr+.ds-bmr{border-top:1px solid rgba(255,255,255,.08)}.ds-n{flex:1;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-sc{font-weight:700;font-variant-numeric:tabular-nums;color:#BAC1CF}.ds-w .ds-n{color:#F3DC9A;font-weight:700}.ds-w .ds-sc{color:#F6F4EF}.ds-l .ds-n{color:#97A0B2}"
    }
  ],
  "narrative": {
    "northStar": "The Fight Poster",
    "overview": "Every match is a LEVA fight poster. Pairings are set as poster duels: two condensed black-italic names split by a skewed gold slash, on deep navy-black. The world borrows from LEVA's Instagram flyers (high contrast, gold as protagonist, epic sports tone) and refuses the sports-SaaS default of white cards, green court accents and flat fixture lists.\n\nThe same world runs at two densities. Player screens are poster-scaled: huge italic names, generous dark ground, one gold primary action. Admin and judge screens keep the type, palette and gold vocabulary but tighten to working density (36px bracket rows, 13px body, 6px-radius list surfaces). The club TV (1920x1080 stage) is the poster at full scale, with the two signature motions: the \"llamado a cancha\" slam-in and the gold sweep on match end.\n\nLegibility outranks drama: a court number, a time or a score is never sacrificed to the poster. Numerals are tabular wherever they change; the gold gradient is reserved so that when it appears it means \"this is yours, this wins, or press this\".",
    "keyCharacteristics": [
      "Deep navy-black ground in four ink steps; shield navy for raised surfaces.",
      "Metallic gold always as a gradient, reserved for names, primary actions, winners and the slash.",
      "One family (Archivo variable) in three widths: 62% black italic display, 100% body, 125% wide-tracked support caps.",
      "Chamfered (cut) corners on primary controls; small radii (4-16px) everywhere else.",
      "Gold hairlines and faint court-line drawings instead of heavy shadow.",
      "Fast, decisive motion on strong ease-out curves; everything reduces to fades or nothing under reduced motion."
    ],
    "rules": [
      {
        "name": "The Gold Is Earned Rule",
        "body": "Gold gradient marks only four things: player/pair names given the spotlight, the primary action, winners, and the slash. Everything else is white, steel or slate on ink.",
        "section": "colors"
      },
      {
        "name": "The Never Flat Yellow Rule",
        "body": "Any gold area larger than a stroke, dot or text glyph is a gradient. Flat gold-500 is for lines and marks only.",
        "section": "colors"
      },
      {
        "name": "The Two Extremes Rule",
        "body": "Display is always width 62 / 900 / italic / uppercase; support is always width 125 / light-regular / wide-tracked caps. Do not use mid widths or upright display.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Every number that changes (scores, times, counts, money, seeds) uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Support Line Labels Data Rule",
        "body": "The tracked support line names a datum (CANCHA, HORA), groups a list, or carries a brand phrase. It does not get stacked as a decorative eyebrow above section titles.",
        "section": "typography"
      },
      {
        "name": "The Hairline Over Shadow Rule",
        "body": "Separate with a 1px line (8%/14% white, or gold-line for \"mine\") before adding shadow. Only panels and floating elements carry shadow.",
        "section": "elevation"
      },
      {
        "name": "The Cut Corner Rule",
        "body": "The chamfer belongs to the primary action (and its paired small buttons). Containers keep soft radii; do not chamfer panels or list items.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** render every gold area as the gold gradient; keep flat gold-500 to strokes, dots and borders.",
      "**Do** set pair names, titles and key numerals in Archivo width 62 / 900 / italic / uppercase, and support lines in width 125 wide-tracked caps.",
      "**Do** separate pairs with the skewed gold slash wherever a match is presented as a pairing.",
      "**Do** chamfer the primary gold action (12px cut) and keep containers at 4-10px radii.",
      "**Do** use tabular figures for all scores, times, counts and money.",
      "**Do** mark \"mine\" and selected with gold-500 or gold-line borders plus gold wash, and live with the red tag and pulsing dot.",
      "**Do** keep every motion on the three named curves and provide the reduced-motion fallback.",
      "**Do** change brand values only in the tokens; they are approximate until LEVA supplies official values."
    ],
    "donts": [
      "**Don't** use flat yellow or a single flat gold fill for buttons, indicators or display text.",
      "**Don't** use white cards, green \"court\" accents or flat fixture lists.",
      "**Don't** spend the gold gradient on secondary actions, decoration or body text.",
      "**Don't** use upright or mid-width display type.",
      "**Don't** stack tracked support lines as eyebrows above section titles.",
      "**Don't** set text below 11px.",
      "**Don't** treat the placeholder shield, typographic portrait plates or \"Logo sponsor\" slots as brand art."
    ]
  }
}